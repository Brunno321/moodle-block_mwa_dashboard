<section class="cl-detail-modal" role="dialog" aria-modal="true" aria-labelledby="clDetailModalTitle">
    <header class="cl-detail-modal-head">
        <div>
            <span class="cl-detail-head-generic" aria-hidden="true">
                <svg class="mwa-ui-icon"><use href="#mwa-icon-user"></use></svg>
            </span>
            <strong id="clDetailModalTitle">{{title}}</strong>
        </div>
        <button type="button" class="cl-detail-modal-close" aria-label="{{close}}">&times;</button>
    </header>
    <div class="cl-detail-modal-body"></div>
</section>
