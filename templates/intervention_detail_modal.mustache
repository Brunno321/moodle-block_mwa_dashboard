<section class="int-record-detail-modal" role="dialog" aria-modal="true" aria-labelledby="intRecordDetailTitle">
    <header class="int-record-detail-modal-head">
        <div>
            <span aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-mail"></use></svg></span>
            <strong id="intRecordDetailTitle">{{title}}</strong>
        </div>
        <button type="button" class="int-record-detail-modal-close" aria-label="{{close}}">&times;</button>
    </header>
    <div class="int-record-detail-modal-body"></div>
</section>
