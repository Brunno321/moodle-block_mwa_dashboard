<div id="block-mwa-dashboard-app"
     class="block-mwa-dashboard-app"
     data-courseid="{{courseid}}"
     data-region="mwa-dashboard">
<svg class="mwa-icon-sprite" aria-hidden="true">
  <symbol id="mwa-icon-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></symbol>
  <symbol id="mwa-icon-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></symbol>
  <symbol id="mwa-icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
  <symbol id="mwa-icon-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
  <symbol id="mwa-icon-flame" viewBox="0 0 24 24"><path d="M12 22c4 0 7-3 7-7 0-3-1.5-5.5-4-8 .2 3-1 4-2 5-1-4-3-7-5-9 0 5-3 7-3 12 0 4 3 7 7 7z"/></symbol>
  <symbol id="mwa-icon-clipboard" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 9h6M9 13h6M9 17h4"/></symbol>
  <symbol id="mwa-icon-file" viewBox="0 0 24 24"><path d="M6 2h8l4 4v16H6z"/><path d="M14 2v5h5M9 12h6M9 16h6"/></symbol>
  <symbol id="mwa-icon-lightbulb" viewBox="0 0 24 24"><path d="M9 18h6M10 22h4M8 14a7 7 0 1 1 8 0c-1 1-1 2-1 4H9c0-2 0-3-1-4z"/></symbol>
  <symbol id="mwa-icon-message" viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></symbol>
  <symbol id="mwa-icon-chart" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></symbol>
  <symbol id="mwa-icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
  <symbol id="mwa-icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
  <symbol id="mwa-icon-hourglass" viewBox="0 0 24 24"><path d="M6 2h12M6 22h12M7 2c0 5 2 7 5 10-3 3-5 5-5 10M17 2c0 5-2 7-5 10 3 3 5 5 5 10"/></symbol>
  <symbol id="mwa-icon-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></symbol>
  <symbol id="mwa-icon-star" viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"/></symbol>
  <symbol id="mwa-icon-eye" viewBox="0 0 24 24"><path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.5"/></symbol>
  <symbol id="mwa-icon-trend-down" viewBox="0 0 24 24"><path d="m3 6 6 6 4-4 8 8M16 16h5v-5"/></symbol>
  <symbol id="mwa-icon-bolt" viewBox="0 0 24 24"><path d="m13 2-8 12h7l-1 8 8-12h-7z"/></symbol>
  <symbol id="mwa-icon-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m6 6 12 12"/></symbol>
  <symbol id="mwa-icon-refresh" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.5 8a7 7 0 0 1 11.5-1l2 5M18 16a7 7 0 0 1-11.5 1l-2-5"/></symbol>
  <symbol id="mwa-icon-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></symbol>
  <symbol id="mwa-icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></symbol>
  <symbol id="mwa-icon-edit" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16zM13 7l4 4"/></symbol>
  <symbol id="mwa-icon-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
  <symbol id="mwa-icon-warning" viewBox="0 0 24 24"><path d="M12 3 2 21h20zM12 9v5M12 18h.01"/></symbol>
  <symbol id="mwa-icon-download" viewBox="0 0 24 24"><path d="M12 3v12M7 10l5 5 5-5M4 21h16"/></symbol>
  <symbol id="mwa-icon-puzzle" viewBox="0 0 24 24"><path d="M8 3h4a3 3 0 1 0 6 0h3v7a3 3 0 1 0 0 6v5h-7a3 3 0 1 0-6 0H3v-7a3 3 0 1 0 0-6V3z"/></symbol>
  <symbol id="mwa-icon-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 9-9M16 7l3 3"/></symbol>
  <symbol id="mwa-icon-pin" viewBox="0 0 24 24"><path d="M12 22v-7M7 3h10l-2 7 3 3H6l3-3z"/></symbol>
  <symbol id="mwa-icon-play" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4z"/></symbol>
  <symbol id="mwa-icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19"/></symbol>
</svg>
<div id="loading" class="loading"><div><div class="spinner"></div><h2 data-i18n="loading_title"></h2><p class="muted" id="loadStatus" data-i18n="loading_waiting"></p></div></div>
<div class="app">
  <div class="topbar"><div class="brand"><div class="brand-inner"><img src="{{wwwroot}}/blocks/mwa_dashboard/pix/logo.png" data-i18n-attr="alt:brand_logo_alt" alt="" class="brand-logo"><div class="brand-text"><span data-i18n="brand_name"></span><br><small data-i18n="brand_subtitle"></small></div></div></div><div class="top-actions">{{#showgroupfilter}}<label class="mwa-group-filter"><span>{{#str}}group_filter_label, block_mwa_dashboard{{/str}}</span><select id="mwaGroupFilter">{{#groups}}<option value="{{id}}"{{#selected}} selected{{/selected}}>{{name}}</option>{{/groups}}</select></label>{{/showgroupfilter}}<input id="search" class="search" placeholder="" data-i18n-attr="placeholder:search_student" style="display:none"></div></div>
  <div class="layout"><aside class="sidebar">
    <div class="nav-title" data-i18n="nav_today"></div>
    <div class="nav-item" data-page="ac" data-action-page="ac"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-target"></use></svg></span><span data-i18n="nav_action_center"></span><span class="nav-badge" id="navActionBadge">0</span></div>
    <div class="nav-item" data-page="alerts" data-action-page="alerts"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-bell"></use></svg></span><span data-i18n="nav_alerts"></span><span class="nav-badge amber" id="navAlertBadge">0</span></div>

    <div class="nav-title" data-i18n="nav_students"></div>
    <div class="nav-item" data-page="classlist" data-action-page="classlist"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-users"></use></svg></span><span data-i18n="nav_class_list"></span><span class="nav-badge ia">IA</span></div>
    <div class="nav-item" data-page="studentprofile" data-action-page="studentprofile"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-user"></use></svg></span><span data-i18n="nav_student_profile"></span></div>
    <div class="nav-item" data-page="heatmap" data-action-page="heatmap"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-flame"></use></svg></span><span data-i18n="nav_access_heatmap"></span></div>

    <div class="nav-title" data-i18n="nav_content"></div>
    <div class="nav-item" data-page="activities" data-action-page="activities"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-clipboard"></use></svg></span><span data-i18n="nav_activities"></span><span class="nav-badge ia">IA</span></div>
    <div class="nav-item" data-page="grades" data-action-page="grades"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-file"></use></svg></span><span data-i18n="nav_grades"></span></div>

    <div class="nav-title" data-i18n="nav_ai"></div>
    <div class="nav-item" data-page="chat" data-action-page="chat"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-lightbulb"></use></svg></span><span data-i18n="nav_chat"></span><span class="nav-badge ia">IA</span></div>

    <div class="nav-title" data-i18n="nav_report"></div>
    <div class="nav-item" data-page="interventions" data-action-page="interventions"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-message"></use></svg></span><span data-i18n="nav_interventions"></span></div>
    <div class="nav-item" data-page="teacherfeedback" data-action-page="teacherfeedback"><span><svg class="mwa-ui-icon"><use href="#mwa-icon-chart"></use></svg></span><span data-i18n="tf_nav"></span><span class="nav-badge ia">IA</span></div>

    <footer class="mwa-sidebar-version" aria-label="{{#str}}pluginversionlabel, block_mwa_dashboard{{/str}} {{pluginrelease}}">
      <span>MWA Analytics Dashboard</span>
      <small>{{#str}}pluginversionlabel, block_mwa_dashboard{{/str}} {{pluginrelease}}</small>
    </footer>
  </aside><button type="button" id="mwaSidebarToggle" class="mwa-sidebar-toggle" aria-expanded="true" aria-label="{{#str}}sidebar_collapse, block_mwa_dashboard{{/str}}" title="{{#str}}sidebar_collapse, block_mwa_dashboard{{/str}}"><span class="mwa-sidebar-toggle-icon" aria-hidden="true">&#8249;</span></button><main class="main">
    <section id="page-ac" class="page">
      <div class="hero ac-hero">
        <div>
          <div class="date" id="todayLabel"></div>
          <h1 class="mwa-page-title"><span class="mwa-page-title-icon" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-target"></use></svg></span><span data-i18n="action_center_title"></span></h1>
          <p id="actionGreeting"></p>
        </div>

      </div>

      <div id="actionCardsRow" class="action-cards-row"></div>
      <div id="kpis" class="kpis"></div>

      <div class="card ac-retention-card">
        <div class="card-head">
          <span>&#128200; <span data-i18n="weekly_retention_curve"></span></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}ac_tip_retention_curve, block_mwa_dashboard{{/str}}" title="{{#str}}ac_tip_retention_curve, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}ac_tip_retention_curve, block_mwa_dashboard{{/str}}">?</span>
        </div>
        <div class="card-body"><canvas id="retentionChart" height="154"></canvas></div>
      </div>

      <div class="grid2">
        <div class="card ac-click-card" data-action-page="classlist" data-cl-filter-target="engaged" role="button" tabindex="0">
          <div class="card-head">&#128201; <span data-i18n="engagement_index"></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}ac_tip_engagement_index, block_mwa_dashboard{{/str}}" title="{{#str}}ac_tip_engagement_index, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}ac_tip_engagement_index, block_mwa_dashboard{{/str}}">?</span></div>
          <div class="card-body"><div class="engage"><div class="gauge" id="gauge" style="--p:0"><div class="gauge-inner"><div><div id="engPct" class="gauge-num">0%</div><div id="engLabel" class="gauge-label" data-i18n="no_data"></div></div></div></div><div><p class="muted" data-i18n="engagement_desc"></p><div class="legend"><span><i class="dot" style="background:var(--red)"></i><span data-i18n="legend_low"></span></span><span><i class="dot" style="background:var(--blue)"></i><span data-i18n="legend_average"></span></span><span><i class="dot" style="background:var(--green)"></i><span data-i18n="legend_high"></span></span></div></div></div></div>
        </div>
        <div class="card ac-event-card">
          <div class="card-head"><svg class="mwa-ui-icon" aria-hidden="true"><use href="#mwa-icon-chart"></use></svg> <span data-i18n="event_distribution"></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}ac_tip_event_distribution, block_mwa_dashboard{{/str}}" title="{{#str}}ac_tip_event_distribution, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}ac_tip_event_distribution, block_mwa_dashboard{{/str}}">?</span></div>
          <div class="card-body"><p class="muted ac-event-description" data-i18n="event_distribution_desc"></p><canvas id="eventChart" height="210"></canvas></div>
        </div>
      </div>

    </section>
    <section id="page-alerts" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="alerts_page_title"></div>
          <h1 class="mwa-page-title"><span class="mwa-page-title-icon" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-bell"></use></svg></span><span data-i18n="alerts_page_title"></span></h1>
          <p data-i18n="alerts_page_subtitle"></p>
        </div>
      </div>
      <div class="sa-kpi-row" id="saKpisRow"></div>
      <div id="saAlertList"></div>
    </section>
    <section id="page-classlist" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="students_label"></div>
          <h1 class="mwa-page-title"><span class="mwa-page-title-icon" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-users"></use></svg></span><span data-i18n="class_list"></span></h1>
          <p data-i18n="class_list_subtitle"></p>
        </div>
      </div>
      <div id="clKpiRow" class="cl-kpi-row"></div>
      <div class="cl-filter-panel">
        <div class="cl-filter-grid">
          <div class="cl-filter-group cl-filter-group-main">
            <label class="cl-filter-label" for="clFilterBar" data-i18n="cl_filter_participation_label"></label>
            <select id="clFilterBar" class="cl-sort-select cl-participation-select"></select>
          </div>
          <div class="cl-filter-group cl-filter-sort-group">
            <label class="cl-filter-label" for="clSort" data-i18n="cl_filter_sort_label"></label>
            <select id="clSort" class="cl-sort-select">
              <option value="risk"         data-i18n="cl_sort_risk"></option>
              <option value="interactions" data-i18n="cl_sort_interactions"></option>
              <option value="alpha"        data-i18n="cl_sort_alpha"></option>
              <option value="participation" data-i18n="cl_sort_participation"></option>
              <option value="time"         data-i18n="cl_sort_time"></option>
            </select>
          </div>
          <div class="cl-filter-group cl-filter-search-group">
            <label class="cl-filter-label" for="clSearch" data-i18n="cl_filter_search_label"></label>
            <label class="cl-search-wrap" for="clSearch">
              <span aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-search"></use></svg></span>
              <input id="clSearch" type="text" class="cl-search"
                data-i18n-attr="placeholder:cl_search_placeholder"
                placeholder="">
            </label>
          </div>
          <div class="cl-filter-group cl-filter-clear-group">
            <span class="cl-filter-label" aria-hidden="true">&nbsp;</span>
            <button type="button" class="cl-filter-clear-btn" data-mwa-action="classlist-clear-filters">&#128465; <span data-i18n="clearfilters"></span></button>
          </div>
        </div>
        <div class="cl-filter-context"><span id="clCount" class="cl-count"></span></div>
      </div>
      <div class="card">
        <div class="cl-card-head">
          <span class="cl-card-title">&#128101; <span data-i18n="class_list"></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}cl_tip_class_list, block_mwa_dashboard{{/str}}" title="{{#str}}cl_tip_class_list, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}cl_tip_class_list, block_mwa_dashboard{{/str}}">?</span></span>
          <button type="button" class="btn-ghost cl-export-btn" onclick="window.MWAClassList&&window.MWAClassList.exportSpreadsheet()">
            <svg class="mwa-ui-icon" aria-hidden="true"><use href="#mwa-icon-file"></use></svg>
            <span data-i18n="cl_export_spreadsheet"></span>
          </button>
        </div>
        <div class="cl-tbl-wrap">
          <table class="cl-tbl" id="clTable">
            <thead>
              <tr>
                <th style="width:10%;" class="center cl-engagement-head" data-i18n="cl_th_participation"></th>
                <th style="width:16%;" data-i18n="student"></th>
                <th style="width:14%;" aria-label="{{#str}}cl_th_situation, block_mwa_dashboard{{/str}}"></th>
                <th style="width:18%;" data-i18n="cl_th_activity_progress"></th>
                <th style="width:18%;" data-i18n="cl_th_resource_progress"></th>
                <th style="width:7%;" class="center" data-i18n="sp_kpi_grade"></th>
                <th style="width:10%;" class="center" data-i18n="cl_th_total_time"></th>
                <th style="width:5%;"></th>
              </tr>
            </thead>
            <tbody id="clTableBody"></tbody>
          </table>
        </div>
        <div class="cl-progress-legend">
          <span><i class="cl-legend-dot done"></i><span data-i18n="cl_legend_done"></span></span>
          <span><i class="cl-legend-dot missing"></i><span data-i18n="cl_legend_missing"></span></span>
          <span><i class="cl-legend-dot overdue"></i><span data-i18n="cl_legend_overdue"></span></span>
        </div>
        <div class="cl-followup-legend" aria-label="{{#str}}cl_followup_legend, block_mwa_dashboard{{/str}}">
          <strong>{{#str}}cl_followup_legend, block_mwa_dashboard{{/str}}:</strong>
          <span><i class="cl-followup-reason overdue">EV</i> {{#str}}cl_followup_overdue, block_mwa_dashboard{{/str}}</span>
          <span><i class="cl-followup-reason inactive">7D</i> {{#str}}cl_followup_inactive, block_mwa_dashboard{{/str}}</span>
          <span><i class="cl-followup-reason grade">&lt;60</i> {{#str}}cl_followup_grade, block_mwa_dashboard{{/str}}</span>
        </div>
        <div id="clPagination" class="cl-pagination"></div>
      </div>
    </section>
    <section id="page-grades" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="grades_label"></div>
          <h1 class="mwa-page-title"><span class="mwa-page-title-icon" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-file"></use></svg></span><span data-i18n="grades_title"></span></h1>
          <p data-i18n="grades_subtitle"></p>
        </div>
      </div>
      <div id="gradesWrap">
        <div class="gr-empty"><div class="gr-empty-icon">&#127891;</div><p data-i18n="gr_no_grades_loaded"></p></div>
      </div>
    </section>
    <section id="page-activities" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="content_label"></div>
          <h1 class="mwa-page-title"><span class="mwa-page-title-icon" aria-hidden="true"><svg class="mwa-ui-icon"><use href="#mwa-icon-clipboard"></use></svg></span><span data-i18n="activities_title"></span></h1>
          <p data-i18n="activities_subtitle"></p>
        </div>
      </div>
      <div class="kpis" id="actKpisRow"></div>
      <div class="act-filter-panel">
        <div class="act-filter-row" id="actFilterRow">
          <div class="act-filter-group">
            <label class="act-filter-label" for="actTypeFilter" data-i18n="act_filter_type_label"></label>
            <select id="actTypeFilter" class="act-standard-select">
              <option value="all" data-i18n="act_filter_all"></option>
              <option value="activity" data-i18n="act_filter_activity"></option>
              <option value="video" data-i18n="act_filter_video"></option>
              <option value="low" data-i18n="act_filter_low"></option>
            </select>
          </div>
          <div class="act-filter-group">
            <label class="act-filter-label" for="actAvailabilityFilter" data-i18n="act_filter_period_label"></label>
            <select id="actAvailabilityFilter" class="act-availability-select">
              <option value="all" data-i18n="act_availability_all"></option>
              <option value="open" data-i18n="act_availability_open"></option>
              <option value="today" data-i18n="act_availability_today"></option>
              <option value="closed" data-i18n="act_availability_closed"></option>
              <option value="future" data-i18n="act_availability_future"></option>
            </select>
          </div>
          <div class="act-filter-group act-filter-search-group">
            <label class="act-filter-label" for="actSearchInput" data-i18n="act_filter_search_label"></label>
            <label class="act-search-wrap">
              <span aria-hidden="true">&#128269;</span>
              <input id="actSearchInput" type="search" autocomplete="off" data-i18n-attr="placeholder:act_search_placeholder" placeholder="">
            </label>
          </div>
          <div class="act-filter-group act-filter-clear-group">
            <span class="act-filter-label" aria-hidden="true">&nbsp;</span>
            <button type="button" id="actClearFilters" class="act-clear-btn">&#128465; <span data-i18n="clearfilters"></span></button>
          </div>
        </div>
      </div>
      <div class="act-list-panel">
        <div class="act-list-titlebar">
          <div class="act-list-title-main">
            <svg class="mwa-ui-icon" aria-hidden="true"><use href="#mwa-icon-clipboard"></use></svg>
            <span data-i18n="act_list_title"></span>
            <span class="mwa-help-tip act-list-help" tabindex="0" role="img" aria-label="{{#str}}act_tip_activity_list, block_mwa_dashboard{{/str}}" title="{{#str}}act_tip_activity_list, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}act_tip_activity_list, block_mwa_dashboard{{/str}}">?</span>
          </div>
        </div>
        <div class="act-list-head" aria-hidden="true">
          <span data-i18n="act_col_completion_rate"></span>
          <span data-i18n="act_col_activity_resource"></span>
          <span data-i18n="act_col_students_access"></span>
          <span data-i18n="act_col_access_count"></span>
