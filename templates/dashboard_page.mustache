<div id="block-mwa-dashboard-app"
     class="block-mwa-dashboard-app"
     data-courseid="{{courseid}}"
     data-region="mwa-dashboard">
<div id="loading" class="loading"><div><div class="spinner"></div><h2 data-i18n="loading_title"></h2><p class="muted" id="loadStatus" data-i18n="loading_waiting"></p></div></div>
<div class="app">
  <div class="topbar"><div class="brand"><div class="brand-inner"><img src="{{wwwroot}}/blocks/mwa_dashboard/pix/logo.png" data-i18n-attr="alt:brand_logo_alt" alt="" class="brand-logo"><div class="brand-text"><span data-i18n="brand_name"></span><br><small data-i18n="brand_subtitle"></small></div></div></div><div class="top-actions"><input id="search" class="search" placeholder="" data-i18n-attr="placeholder:search_student" style="display:none"></div></div>
  <div class="layout"><aside class="sidebar">
    <div class="nav-title" data-i18n="nav_today"></div>
    <div class="nav-item" data-page="ac" data-action-page="ac"><span>&#127919;</span><span data-i18n="nav_action_center"></span><span class="nav-badge" id="navActionBadge">0</span></div>
    <div class="nav-item" data-page="alerts" data-action-page="alerts"><span>&#128276;</span><span data-i18n="nav_alerts"></span><span class="nav-badge amber" id="navAlertBadge">0</span></div>

    <div class="nav-title" data-i18n="nav_students"></div>
    <div class="nav-item" data-page="classlist" data-action-page="classlist"><span>&#128101;</span><span data-i18n="nav_class_list"></span><span class="nav-badge ia">IA</span></div>
    <div class="nav-item" data-page="studentprofile" data-action-page="studentprofile"><span>&#128100;</span><span data-i18n="nav_student_profile"></span></div>
    <div class="nav-item" data-page="heatmap" data-action-page="heatmap"><span>&#128293;</span><span data-i18n="nav_access_heatmap"></span></div>

    <div class="nav-title" data-i18n="nav_content"></div>
    <div class="nav-item" data-page="activities" data-action-page="activities"><span>&#128203;</span><span data-i18n="nav_activities"></span><span class="nav-badge ia">IA</span></div>
    <div class="nav-item" data-page="grades" data-action-page="grades"><span>&#128221;</span><span data-i18n="nav_grades"></span></div>

    <div class="nav-title" data-i18n="nav_ai"></div>
    <div class="nav-item" data-page="chat" data-action-page="chat"><span>&#128161;</span><span data-i18n="nav_chat"></span><span class="nav-badge ia">IA</span></div>

    <div class="nav-title" data-i18n="nav_report"></div>
    <div class="nav-item" data-page="interventions" data-action-page="interventions"><span>&#128172;</span><span data-i18n="nav_interventions"></span></div>
    <div class="nav-item" data-page="teacherfeedback" data-action-page="teacherfeedback"><span>&#128200;</span><span data-i18n="tf_nav"></span></div>

  </aside><button type="button" id="mwaSidebarToggle" class="mwa-sidebar-toggle" aria-expanded="true" aria-label="{{#str}}sidebar_collapse, block_mwa_dashboard{{/str}}" title="{{#str}}sidebar_collapse, block_mwa_dashboard{{/str}}"><span class="mwa-sidebar-toggle-icon" aria-hidden="true">&#8249;</span></button><main class="main">
    <section id="page-ac" class="page">
      <div class="hero ac-hero">
        <div>
          <div class="date" id="todayLabel"></div>
          <h1><span data-i18n="action_center_title"></span></h1>
          <p id="actionGreeting"></p>
        </div>

      </div>

      <div id="actionCardsRow" class="action-cards-row"></div>
      <div id="kpis" class="kpis"></div>

      <div class="card ac-retention-card">
        <div class="card-head">
          <span>&#128200; <span data-i18n="weekly_retention_curve"></span></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}ac_tip_retention_curve, block_mwa_dashboard{{/str}}" title="{{#str}}ac_tip_retention_curve, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}ac_tip_retention_curve, block_mwa_dashboard{{/str}}">?</span>
        </div>
        <div class="card-body"><canvas id="retentionChart" height="154"></canvas></div>
      </div>

      <div class="grid2">
        <div class="card ac-click-card" data-action-page="classlist" role="button" tabindex="0">
          <div class="card-head">&#128201; <span data-i18n="engagement_index"></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}ac_tip_engagement_index, block_mwa_dashboard{{/str}}" title="{{#str}}ac_tip_engagement_index, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}ac_tip_engagement_index, block_mwa_dashboard{{/str}}">?</span></div>
          <div class="card-body"><div class="engage"><div class="gauge" id="gauge" style="--p:0"><div class="gauge-inner"><div><div id="engPct" class="gauge-num">0%</div><div id="engLabel" class="gauge-label" data-i18n="no_data"></div></div></div></div><div><p class="muted" data-i18n="engagement_desc"></p><div class="legend"><span><i class="dot" style="background:var(--red)"></i><span data-i18n="legend_low"></span></span><span><i class="dot" style="background:var(--blue)"></i><span data-i18n="legend_average"></span></span><span><i class="dot" style="background:var(--green)"></i><span data-i18n="legend_high"></span></span></div></div></div></div>
        </div>
        <div class="card">
          <div class="card-head">&#128202; <span data-i18n="event_distribution"></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}ac_tip_event_distribution, block_mwa_dashboard{{/str}}" title="{{#str}}ac_tip_event_distribution, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}ac_tip_event_distribution, block_mwa_dashboard{{/str}}">?</span></div>
          <div class="card-body"><canvas id="eventChart" height="210"></canvas></div>
        </div>
      </div>

    </section>
    <section id="page-alerts" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="alerts_page_title"></div>
          <h1 data-i18n="alerts_page_title"></h1>
          <p data-i18n="alerts_page_subtitle"></p>
        </div>
      </div>
      <div class="sa-kpi-row" id="saKpisRow"></div>
      <div id="saAlertList"></div>
    </section>
    <section id="page-classlist" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="students_label"></div>
          <h1 data-i18n="class_list"></h1>
          <p data-i18n="class_list_subtitle"></p>
        </div>
      </div>
      <div id="clKpiRow" class="cl-kpi-row"></div>
      <div id="clFilterBar" class="cl-filter-bar"></div>
      <div class="card">
        <div class="cl-card-head">
          <span class="cl-card-title">&#128101; <span data-i18n="class_list"></span><span class="mwa-help-tip" tabindex="0" role="img" aria-label="{{#str}}cl_tip_class_list, block_mwa_dashboard{{/str}}" title="{{#str}}cl_tip_class_list, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}cl_tip_class_list, block_mwa_dashboard{{/str}}">?</span></span>
          <select id="clSort" class="cl-sort-select">
            <option value="risk"         data-i18n="cl_sort_risk"></option>
            <option value="interactions" data-i18n="cl_sort_interactions"></option>
            <option value="alpha"        data-i18n="cl_sort_alpha"></option>
            <option value="participation" data-i18n="cl_sort_participation"></option>
            <option value="time"         data-i18n="cl_sort_time"></option>
          </select>
          <input id="clSearch" type="text" class="cl-search"
            data-i18n-attr="placeholder:cl_search_placeholder"
            placeholder="">
          <span id="clCount" class="cl-count"></span>
        </div>
        <div class="cl-tbl-wrap">
          <table class="cl-tbl" id="clTable">
            <thead>
              <tr>
                <th style="width:25%;" data-i18n="student"></th>
                <th style="width:18%;" data-i18n="cl_th_participation"></th>
                <th style="width:15%;" data-i18n="cl_th_activity_progress"></th>
                <th style="width:15%;" data-i18n="cl_th_resource_progress"></th>
                <th style="width:8%;" class="center" data-i18n="interactions"></th>
                <th style="width:10%;" class="center" data-i18n="cl_th_total_time"></th>
                <th style="width:5%;"></th>
              </tr>
            </thead>
            <tbody id="clTableBody"></tbody>
          </table>
        </div>
        <div class="cl-progress-legend">
          <span><i class="cl-legend-dot done"></i><span data-i18n="cl_legend_done"></span></span>
          <span><i class="cl-legend-dot missing"></i><span data-i18n="cl_legend_missing"></span></span>
        </div>
      </div>
    </section>
    <section id="page-grades" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="grades_label"></div>
          <h1 data-i18n="grades_title"></h1>
          <p data-i18n="grades_subtitle"></p>
        </div>
      </div>
      <div id="gradesWrap">
        <div class="gr-empty"><div class="gr-empty-icon">&#127891;</div><p data-i18n="gr_no_grades_loaded"></p></div>
      </div>
    </section>
    <section id="page-activities" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="content_label"></div>
          <h1 data-i18n="activities_title"></h1>
          <p data-i18n="activities_subtitle"></p>
        </div>
      </div>
      <div class="kpis" id="actKpisRow"></div>
      <div class="act-filter-row" id="actFilterRow">
        <button class="act-tab active" id="actTabAll" data-mwa-action="activity-filter" data-filter="all"   data-i18n="act_filter_all"></button>
        <button class="act-tab"       id="actTabForum" data-mwa-action="activity-filter" data-filter="forum"  data-i18n="act_filter_forum"></button>
        <button class="act-tab"       id="actTabTask" data-mwa-action="activity-filter" data-filter="tarefa" data-i18n="act_filter_task"></button>
        <button class="act-tab"       id="actTabQuiz" data-mwa-action="activity-filter" data-filter="quiz"   data-i18n="act_filter_quiz"></button>
        <button class="act-tab"       id="actTabVideo" data-mwa-action="activity-filter" data-filter="video"  data-i18n="act_filter_video"></button>
      </div>
      <div class="act-resource-grid" id="actResourceGrid"></div>
    </section>
    <section id="page-heatmap" class="page"><div class="hero"><div><div class="date" data-i18n="analysis_label"></div><h1 data-i18n="heatmap_title"></h1><p data-i18n="heatmap_subtitle"></p></div><div class="hero-actions"><label class="hm-search-wrap"><span aria-hidden="true">&#128269;</span><input id="heatmapSearchInput" type="search" data-i18n-attr="placeholder:hm_search_placeholder" placeholder=""></label><select id="heatmapStudentSel" class="hm-filter-select"></select><select id="heatmapModSel" class="hm-filter-select"></select><select id="heatmapModeSel" class="hm-filter-select"></select></div></div><div id="heatmapDateFilters" class="hm-date-filters"><button type="button" class="btn-accent" data-hm-range="7" data-i18n="hm_range_7d"></button><button type="button" class="btn-ghost" data-hm-range="today" data-i18n="hm_range_today"></button><button type="button" class="btn-ghost" data-hm-range="30" data-i18n="hm_range_30d"></button><button type="button" class="btn-ghost" data-hm-range="month" data-i18n="hm_range_month"></button><button type="button" class="btn-ghost" data-hm-range="custom" data-i18n="hm_range_custom"></button><input id="heatmapStartDate" type="date" class="hm-date-input"><input id="heatmapEndDate" type="date" class="hm-date-input"></div><div id="heatmapKpis" class="hm-kpis"></div><div class="hm-layout"><div class="hm-main"><div class="card"><div class="card-head"><span data-i18n="day_hour"></span><span id="heatmapLegend" class="hm-legend-row"></span></div><div class="card-body" style="overflow:auto;padding:12px 8px;"><div id="heatmap" class="heat"></div><div id="heatmapTooltip" class="hm-tooltip" style="display:none;"></div></div></div><div id="heatmapDetail" class="card hm-detail-card"></div></div><div class="hm-side"><div class="card"><div class="card-head">&#128161; <span data-i18n="hm_insights_title"></span></div><div class="card-body" id="heatmapInsights" style="padding:14px 16px;"></div></div><div class="card" style="margin-top:0;"><div class="card-head">&#128202; <span data-i18n="hm_grades_title"></span></div><div class="card-body" id="heatmapGradeCorr" style="padding:14px 16px;"></div></div><div class="card" style="margin-top:0;"><div class="card-head">&#9200; <span data-i18n="hm_besttime_title"></span></div><div class="card-body" id="heatmapBestTime" style="padding:14px 16px;"></div></div></div></div></section>
    <section id="page-studentprofile" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="nav_student_profile"></div>
          <h1 data-i18n="nav_student_profile"></h1>
          <p data-i18n="sp_page_subtitle"></p>
        </div>
      </div>
      <div class="sp-selector-bar">
        <span class="sp-selector-label" data-i18n="sp_select_label"></span>
        <div class="sp-autocomplete-wrap" id="spAutocompleteWrap">
          <span class="sp-search-icon" aria-hidden="true">&#128269;</span>
          <input id="spStudentSearch" type="text" class="sp-autocomplete-input"
            data-i18n-attr="placeholder:sp_search_student_placeholder" placeholder=""
            autocomplete="off" spellcheck="false">
          <button type="button" class="sp-autocomplete-clear" id="spSearchClear" data-i18n-attr="aria-label:sp_search_clear" aria-label="{{#str}}sp_search_clear, block_mwa_dashboard{{/str}}" style="display:none;">&#10005;</button>
          <ul id="spAutocompleteDrop" class="sp-autocomplete-drop" role="listbox" style="display:none;"></ul>
        </div>
        <select id="spStudentSel" style="display:none;">
          <option value=""></option>
        </select>
      </div>
      <div id="spContent">
        <div class="sp-empty">
          <div class="sp-empty-icon">&#128100;</div>
          <p data-i18n="sp_select_hint"></p>
        </div>
      </div>
    </section>
    <section id="page-chat" class="page" style="padding:0;"><div style="display:flex;height:calc(100vh - 68px);gap:0;"><div id="chatSidebar" style="width:210px;flex-shrink:0;display:flex;flex-direction:column;gap:.3rem;border-right:1px solid var(--line);padding:.75rem .6rem;background:var(--panel);"><div style="font-size:.62rem;font-weight:700;color:var(--muted);letter-spacing:.07em;text-transform:uppercase;padding:.25rem .5rem .4rem;" data-i18n="chat_history"></div><div id="chatHistoryList" style="display:flex;flex-direction:column;gap:2px;flex:1;overflow-y:auto;"></div><button class="btn-ghost" id="chatNewBtn" data-chat-new="1" style="font-size:.75rem;margin-top:.5rem;">&#65291; <span data-i18n="chat_new_conv"></span></button></div><div style="flex:1;display:flex;flex-direction:column;background:var(--panel2);"><div style="display:flex;align-items:center;gap:.65rem;padding:.75rem 1rem;border-bottom:1px solid var(--line);flex-shrink:0;background:var(--panel);"><div style="width:30px;height:30px;border-radius:9px;background:var(--blue-dim);display:flex;align-items:center;justify-content:center;font-size:.9rem;">&#10022;</div><div><div style="font-size:.85rem;font-weight:700;display:flex;align-items:center;gap:6px;"><span id="chatConvTitle" data-i18n="chat_assistant_name"></span><span class="mwa-help-tip chat-help-tip" tabindex="0" role="img" aria-label="{{#str}}chat_assistant_tip, block_mwa_dashboard{{/str}}" title="{{#str}}chat_assistant_tip, block_mwa_dashboard{{/str}}" data-tooltip="{{#str}}chat_assistant_tip, block_mwa_dashboard{{/str}}">?</span></div><div style="font-size:.68rem;color:var(--muted);" id="chatConvSub" data-i18n="chat_no_data_sub"></div></div><div style="margin-left:auto;display:flex;gap:.35rem;" id="chatContextChips"></div></div><div id="chatMessages" style="flex:1;overflow-y:auto;padding:.85rem 1rem;display:flex;flex-direction:column;gap:.65rem;"></div><div id="chatSuggestions" style="padding:0 1rem .5rem;display:flex;flex-wrap:wrap;gap:.3rem;"></div><div style="padding:.65rem .85rem;border-top:1px solid var(--line);display:flex;gap:.5rem;align-items:flex-end;flex-shrink:0;background:var(--panel);"><textarea id="chatInput" rows="1" style="flex:1;resize:none;background:var(--panel2);border:1px solid var(--line2);border-radius:var(--radius-xl);padding:.5rem .85rem;font-family:inherit;font-size:.82rem;color:var(--text);outline:none;line-height:1.5;"></textarea><button class="btn-accent" style="font-size:.8rem;padding:.5rem .9rem;flex-shrink:0;" id="chatSendBtn">&#11014;</button></div></div></div></section>
    

    <section id="page-interventions" class="page">
      <div class="hero">
        <div>
          <div class="date">&#128172;</div>
          <h1 data-i18n="int_page_title"></h1>
          <p data-i18n="int_page_subtitle"></p>
        </div>
      </div>
      <div id="interventionsWrap">
        <div class="gr-empty"><div class="gr-empty-icon">&#128172;</div><p data-i18n="int_no_data"></p></div>
      </div>
    </section>
    <section id="page-teacherfeedback" class="page">
      <div class="hero">
        <div>
          <div class="date" data-i18n="nav_report"></div>
          <h1 data-i18n="tf_page_title"></h1>
          <p data-i18n="tf_page_subtitle"></p>
        </div>
      </div>
      <div id="teacherFeedbackWrap">
        <div class="gr-empty"><div class="gr-empty-icon">&#128200;</div><p data-i18n="tf_no_data"></p></div>
      </div>
    </section>
  </main></div>
</div>
</div>
